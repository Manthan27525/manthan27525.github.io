---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-5 py-10 text-[13px] text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="flex items-center gap-2.5">
      <Logo size={22} id="footer" class="shrink-0" />
      © {year} {site.name}. Built with Astro, TypeScript and Tailwind CSS.
    </p>
    <ul class="flex items-center gap-6">
      <li>
        <a href={site.links.github} class="inline-flex items-center gap-1.5 transition-colors hover:text-accent" rel="me noopener" target="_blank">
          <Icon name="github" size={14} /> GitHub
        </a>
      </li>
      <li>
        <a href={site.links.linkedin} class="inline-flex items-center gap-1.5 transition-colors hover:text-accent" rel="me noopener" target="_blank">
          <Icon name="linkedin" size={14} /> LinkedIn
        </a>
      </li>
      <li>
        <a href={site.links.x} class="inline-flex items-center gap-1.5 transition-colors hover:text-accent" rel="me noopener" target="_blank">
          <Icon name="x" size={13} /> X
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-1.5 transition-colors hover:text-accent">
          <Icon name="mail" size={14} /> Email
        </a>
      </li>
    </ul>
  </div>
</footer>
