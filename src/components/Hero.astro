---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { categories, projects } from '../data/projects';

const featuredSlugs = ['autodml', 'sql-data-warehouse', 'nifty50-stock-forecasting', 'global-superstore-analysis', 'yearly-inflation-calculator'];
const featured = featuredSlugs.map((s) => projects.find((p) => p.slug === s)!);
const liveCount = projects.filter((p) => p.demo).length;

// Real distribution of projects per category, drawn as a small bar chart.
const dist = categories.map((c) => ({ c, n: projects.filter((p) => p.categories.includes(c)).length }));
const maxN = Math.max(...dist.map((d) => d.n));
---

<section class="relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="container-page relative pt-16 pb-20 sm:pt-24 lg:pt-28 lg:pb-28">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-line pb-5" data-reveal>
      <p class="eyebrow flex items-center gap-2.5"><span class="size-1.5 bg-accent" aria-hidden="true"></span> Data Scientist</p>
      <p class="flex items-center gap-2 font-mono text-[11px] text-muted">
        <Icon name="map-pin" size={12} />
        Himachal Pradesh, India
      </p>
    </div>

    <h1
      id="hero-title"
      class="mt-12 max-w-6xl text-[2.85rem] leading-[0.98] font-semibold text-balance sm:mt-16 sm:text-7xl lg:text-[6.25rem]"
      style="letter-spacing:-0.055em"
      data-reveal
    >
      Turning data into <span class="serif text-accent">decisions</span> &amp; intelligent systems
    </h1>

    <div class="mt-14 grid gap-16 lg:mt-20 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5" data-reveal>
        <p class="max-w-md text-lg leading-relaxed text-pretty text-muted">
          I’m <strong class="font-semibold text-fg">Manthan Singh</strong>. I work across data science, analytics, machine
          learning and AI: SQL warehouses and EDA, AutoML pipelines, deep-learning forecasting on NIFTY 50 data, and
          fine-tuned transformer models.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#projects" class="btn btn-primary">View projects <Icon name="arrow-right" size={15} class="nudge" /></a>
          <a href={site.resume} class="btn btn-secondary" download><Icon name="download" size={15} /> Download resume</a>
        </div>
        <div class="mt-6 flex flex-wrap gap-7 text-sm font-medium">
          <a href={site.links.github} class="inline-flex items-center gap-2 text-fg transition-colors hover:text-accent" target="_blank" rel="me noopener">
            <Icon name="github" size={15} /> GitHub <Icon name="arrow-up-right" size={12} class="text-accent" />
          </a>
          <a href={site.links.linkedin} class="inline-flex items-center gap-2 text-fg transition-colors hover:text-accent" target="_blank" rel="me noopener">
            <Icon name="linkedin" size={15} /> LinkedIn <Icon name="arrow-up-right" size={12} class="text-accent" />
          </a>
          <a href={site.links.x} class="inline-flex items-center gap-2 text-fg transition-colors hover:text-accent" target="_blank" rel="me noopener">
            <Icon name="x" size={14} /> X / Twitter <Icon name="arrow-up-right" size={12} class="text-accent" />
          </a>
        </div>

        <dl class="mt-14 grid grid-cols-3 border-y border-fg/80">
          <div class="py-4 pr-4">
            <dt class="font-mono text-[10.5px] tracking-wide text-muted uppercase">projects</dt>
            <dd class="mt-1.5 text-3xl font-semibold tracking-tight tabular-nums">{projects.length}</dd>
          </div>
          <div class="border-l border-line px-4 py-4">
            <dt class="font-mono text-[10.5px] tracking-wide text-muted uppercase">live apps &amp; sites</dt>
            <dd class="mt-1.5 text-3xl font-semibold tracking-tight tabular-nums">{liveCount}</dd>
          </div>
          <div class="border-l border-line py-4 pl-4">
            <dt class="font-mono text-[10.5px] tracking-wide text-muted uppercase">B.Tech CSE</dt>
            <dd class="mt-1.5 text-3xl font-semibold tracking-tight tabular-nums">2022–26</dd>
          </div>
        </dl>

        <figure class="mt-7" aria-label="Projects by category">
          <figcaption class="flex items-center justify-between font-mono text-[10.5px] tracking-wide text-muted uppercase">
            <span>Projects by category</span><span>n</span>
          </figcaption>
          <ul class="mt-3 space-y-2">
            {
              dist.map((d) => (
                <li class="grid grid-cols-[7.5rem_1fr_1.5rem] items-center gap-3 font-mono text-[11px] text-muted">
                  <span class="truncate">{d.c}</span>
                  <span class="h-2 bg-surface-2" aria-hidden="true">
                    <span
                      class:list={['bar block h-full', d.n === maxN ? 'bg-accent' : 'bg-fg/80']}
                      style={`--w:${(d.n / maxN) * 100}%`}
                    />
                  </span>
                  <span class:list={['text-right tabular-nums', d.n === maxN ? 'text-accent' : 'text-fg']}>{d.n}</span>
                </li>
              ))
            }
          </ul>
        </figure>
      </div>

      <aside class="lg:col-span-6 lg:col-start-7" aria-label="Selected projects" data-reveal>
        <div class="flex items-center justify-between border-b border-fg/80 pb-3">
          <p class="eyebrow text-fg">Selected work</p>
          <a href="#projects" class="font-mono text-[11px] text-accent hover:underline">view all →</a>
        </div>
        <ol>
          {
            featured.map((p, i) => (
              <li class="border-b border-line">
                <a href={`/projects/${p.slug}/`} class="group grid grid-cols-[2.5rem_1fr_auto] gap-x-3 py-6">
                  <span class="pt-1.5 font-mono text-[11px] text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                  <span class="min-w-0">
                    <span class="block text-xl font-semibold tracking-tight transition-colors group-hover:text-accent">
                      {p.name}
                    </span>
                    <span class="mt-1.5 block text-sm leading-snug text-muted">{p.tagline}</span>
                    <span class="mt-3 block font-mono text-[10.5px] tracking-[0.1em] text-muted uppercase">
                      {p.categories.join(' / ')}
                    </span>
                  </span>
                  <span class="mt-1 grid size-8 place-items-center rounded-[3px] border border-line text-fg transition-all duration-200 group-hover:border-accent group-hover:text-accent">
                    <Icon name="arrow-up-right" size={14} />
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, var(--border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 60% 55% at 85% 10%, #000 20%, transparent 70%);
    opacity: 0.7;
  }
  .bar {
    width: var(--w);
    transform-origin: left;
    animation: grow 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
</style>
