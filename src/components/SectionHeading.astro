---
// Editorial section header: index + label on the left, large title on the right.
interface Props {
  index: string;
  label: string;
  id: string;
}

const { index, label, id } = Astro.props;
---

<div class="grid gap-6 border-t border-fg/80 pt-6 lg:grid-cols-12 lg:gap-8" data-reveal>
  <p class="eyebrow flex items-center gap-3 self-start lg:col-span-3 lg:pt-5">
    <span class="text-accent">{index}</span>
    <span class="h-px w-6 bg-line-strong" aria-hidden="true"></span>
    {label}
  </p>
  <div class="lg:col-span-9">
    <h2 id={id} class="section-title max-w-4xl">
      <slot />
    </h2>
    {
      Astro.slots.has('intro') && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
          <slot name="intro" />
        </p>
      )
    }
  </div>
</div>
