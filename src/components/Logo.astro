---
// "MS" monogram, vector-traced from the source PNGs in public/.
// Light theme: dark mark (public/logo.svg, from favicon.png).
// Dark theme: white mark (public/logo-w.svg, from logo-w.png).
interface Props {
  size?: number;
  class?: string;
  /** Unique suffix for gradient ids when the logo appears more than once on a page. */
  id?: string;
}

const { size = 32, class: className = '', id = 'logo' } = Astro.props;
const g = (name: string) => `${name}-${id}`;
---

<span class:list={['logo inline-block shrink-0 overflow-hidden', className]} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg class="logo-on-light" xmlns="http://www.w3.org/2000/svg" viewBox="197 190 860 860" width={size} height={size} focusable="false">
    <defs>
      <linearGradient id={g('ms-s')} x1="652" y1="470" x2="996" y2="772" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FE9B23"></stop>
        <stop offset="1" stop-color="#BE4B0C"></stop>
      </linearGradient>
      <linearGradient id={g('ms-v')} x1="0" y1="455" x2="0" y2="849" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FC981F"></stop>
        <stop offset="1" stop-color="#D5610E"></stop>
      </linearGradient>
    </defs>
    <rect x="197" y="190" width="860" height="860" rx="150" fill="#060606"></rect>
    <path fill="#F6F2EC" d="M258 391 478 583 618 461V841L549 775V635L478 697 333 577V823H258Z"></path>
    <path fill={`url(#${g('ms-v')})`} d="M619 461 626 455V849L619 842Z"></path>
    <path fill={`url(#${g('ms-v')})`} d="M355 736 381 721V823H355ZM398 688 425 673V823H398Z"></path>
    <path fill="#F6F2EC" d="M740 391H996V568L908 485H692L665 463Z"></path>
    <path fill={`url(#${g('ms-s')})`} d="M652 470 780 577H906L996 662V772L870 660H750L652 580Z"></path>
    <path fill="#F6F2EC" d="M652 737H940L988 780 945 823H652Z"></path>
  </svg>

  <svg class="logo-on-dark" xmlns="http://www.w3.org/2000/svg" viewBox="95 89 1064 1064" width={size} height={size} focusable="false">
    <defs>
      <linearGradient id={g('msw-s')} x1="650" y1="436" x2="1084" y2="805" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FFA21C"></stop>
        <stop offset="1" stop-color="#C44304"></stop>
      </linearGradient>
      <linearGradient id={g('msw-v')} x1="0" y1="425" x2="0" y2="895" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#FFA21C"></stop>
        <stop offset="1" stop-color="#D4560A"></stop>
      </linearGradient>
    </defs>
    <rect x="95" y="89" width="1064" height="1064" rx="186" fill="#FEFEFE"></rect>
    <path fill="#141414" d="M169 348 439 597 612 441V880L529 800V634L430 724 254 568V863H169Z"></path>
    <path fill={`url(#${g('msw-v')})`} d="M614 440 630 425V895L614 880Z"></path>
    <path fill={`url(#${g('msw-v')})`} d="M272 762 305 740V863H272ZM323 704 357 684V863H323Z"></path>
    <path fill="#141414" d="M748 350H1084V558L975 454H698L669 426Z"></path>
    <path fill={`url(#${g('msw-s')})`} d="M650 436 795 561H963L1084 665V805L920 663H764L650 570Z"></path>
    <path fill="#141414" d="M650 762H1003L1063 814 1015 863H650Z"></path>
  </svg>
</span>

<style>
  /* Exactly one mark is visible per theme. Both rules use the same selector shape
     so neither can out-rank the other. */
  .logo > .logo-on-light {
    display: block;
  }
  .logo > .logo-on-dark {
    display: none;
  }
  :global([data-theme='dark']) .logo > .logo-on-light {
    display: none;
  }
  :global([data-theme='dark']) .logo > .logo-on-dark {
    display: block;
  }
</style>
