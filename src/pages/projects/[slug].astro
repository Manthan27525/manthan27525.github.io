---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project: p, next } = Astro.props;
const d = p.details;

const toc = [
  { id: 'overview', label: 'Overview' },
  { id: 'problem', label: 'Problem' },
  { id: 'dataset', label: 'Dataset' },
  { id: 'approach', label: 'Approach' },
  { id: 'results', label: 'Results' },
  { id: 'stack', label: 'Tech stack' },
  { id: 'challenges', label: 'Challenges' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.name,
  description: p.tagline,
  author: { '@type': 'Person', name: site.name, url: Astro.site?.toString() },
  keywords: p.stack.join(', '),
  ...(p.repo ? { codeRepository: p.repo } : {}),
  ...(p.demo ? { url: p.demo } : {}),
};
---

<BaseLayout title={p.name} description={`${p.tagline} ${p.problem}`.slice(0, 300)} type="article" jsonLd={jsonLd}>
  <article>
    <header class="border-b border-line">
      <div class="container-page pt-10 pb-16 sm:pt-14 sm:pb-20">
        <nav aria-label="Breadcrumb">
          <a href="/#projects" class="inline-flex items-center gap-2 font-mono text-[11px] tracking-wide text-muted uppercase transition-colors hover:text-accent">
            <Icon name="arrow-left" size={14} /> All projects
          </a>
        </nav>
        <div class="mt-14 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-6">
          {p.categories.map((c) => <span class="tag">{c}</span>)}
          {p.status && <span class="chip border-accent/50 text-accent">{p.status}</span>}
        </div>
        <h1 class="mt-8 max-w-5xl text-5xl font-semibold text-balance sm:text-7xl lg:text-8xl" style="letter-spacing:-0.055em;line-height:0.98">
          {p.name}
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-muted">{p.tagline}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          {
            p.repo && (
              <a href={p.repo} class="btn btn-primary" target="_blank" rel="noopener">
                <Icon name="github" size={15} /> View on GitHub
              </a>
            )
          }
          {
            p.demo && (
              <a href={p.demo} class:list={['btn', p.repo ? 'btn-secondary' : 'btn-primary']} target="_blank" rel="noopener">
                <Icon name="arrow-up-right" size={15} /> {p.demoLabel ?? 'Live demo'}
              </a>
            )
          }
        </div>

        {
          p.stats && (
            <dl class="mt-14 grid max-w-3xl grid-cols-3 border-y border-fg/80">
              {p.stats.map((s, i) => (
                <div class:list={['py-6', i > 0 && 'border-l border-line pl-5 sm:pl-8']}>
                  <dt class="sr-only">{s.label}</dt>
                  <dd class="text-2xl font-semibold tracking-tight tabular-nums sm:text-5xl" style="letter-spacing:-0.045em">
                    {s.value}
                  </dd>
                  <dd class="mt-2 font-mono text-[11px] text-muted">{s.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </header>

    <div class="container-page grid gap-12 py-16 sm:py-24 lg:grid-cols-12 lg:gap-8">
      <aside class="hidden lg:col-span-3 lg:block">
        <nav aria-label="On this page" class="sticky top-24">
          <p class="eyebrow">On this page</p>
          <ul class="mt-3 space-y-2 border-l border-line text-sm">
            {
              toc.map((t) => (
                <li>
                  <a href={`#${t.id}`} class="-ml-px block border-l border-transparent pl-4 text-muted transition-colors hover:border-accent hover:text-fg">
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class="max-w-3xl space-y-16 leading-relaxed lg:col-span-8 lg:col-start-5">
        <section id="overview" aria-labelledby="h-overview">
          <h2 id="h-overview" class="eyebrow">Overview</h2>
          <p class="mt-4 text-2xl leading-snug text-pretty" style="letter-spacing:-0.02em">{d.overview}</p>
        </section>

        <section id="problem" aria-labelledby="h-problem" class="grid gap-4 sm:grid-cols-2">
          <div class="card p-6">
            <h2 id="h-problem" class="eyebrow">Problem</h2>
            <p class="mt-3 text-fg/90">{p.problem}</p>
          </div>
          <div class="card p-6">
            <h2 class="eyebrow">Solution</h2>
            <p class="mt-3 text-fg/90">{p.solution}</p>
          </div>
        </section>

        <section id="dataset" aria-labelledby="h-dataset">
          <h2 id="h-dataset" class="eyebrow">Dataset</h2>
          <p class="mt-3 text-muted">{d.dataset}</p>
        </section>

        <section id="approach" aria-labelledby="h-approach">
          <h2 id="h-approach" class="eyebrow">Approach</h2>
          <ol class="mt-5 border-t border-line">
            {
              d.approach.map((step, i) => (
                <li class="flex gap-5 border-b border-line py-4">
                  <span class="mt-1 font-mono text-[11px] text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-muted">{step}</span>
                </li>
              ))
            }
          </ol>
          <h3 class="eyebrow mt-10">Key features</h3>
          <ul class="mt-3 space-y-2">
            {
              p.features.map((f) => (
                <li class="flex gap-3 text-muted">
                  <span class="mt-3 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                  {f}
                </li>
              ))
            }
          </ul>
        </section>

        <section id="results" aria-labelledby="h-results">
          <h2 id="h-results" class="eyebrow">Results</h2>
          <ul class="mt-4 space-y-2">
            {
              d.results.map((r) => (
                <li class="flex gap-3 text-muted">
                  <span class="mt-3 h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                  {r}
                </li>
              ))
            }
          </ul>
        </section>

        <section id="stack" aria-labelledby="h-stack">
          <h2 id="h-stack" class="eyebrow">Tech stack</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {p.stack.map((t) => <li class="rounded-[2px] border border-line bg-surface px-3 py-1.5 text-sm">{t}</li>)}
          </ul>
        </section>

        <section id="challenges" aria-labelledby="h-challenges">
          <h2 id="h-challenges" class="eyebrow">Challenges</h2>
          <div class="mt-4 space-y-4">
            {
              d.challenges.map((c) => (
                <div class="card p-6">
                  <h3 class="text-lg font-medium tracking-tight">{c.title}</h3>
                  <p class="mt-2 text-muted">{c.body}</p>
                </div>
              ))
            }
          </div>
        </section>

        <section aria-label="Links" class="flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex flex-wrap gap-3">
            {
              p.repo && (
                <a href={p.repo} class="btn btn-secondary" target="_blank" rel="noopener">
                  <Icon name="github" size={15} /> Source code
                </a>
              )
            }
            {
              p.demo && (
                <a href={p.demo} class="btn btn-secondary" target="_blank" rel="noopener">
                  <Icon name="arrow-up-right" size={15} /> {p.demoLabel ?? 'Live demo'}
                </a>
              )
            }
          </div>
          <a href={`/projects/${next.slug}/`} class="group text-right text-sm">
            <span class="eyebrow block">Next project</span>
            <span class="mt-1 inline-flex items-center gap-1.5 text-lg font-medium tracking-tight transition-colors group-hover:text-accent">
              {next.name} <Icon name="arrow-right" size={14} />
            </span>
          </a>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>
