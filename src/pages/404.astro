---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <section class="container-page flex min-h-[60vh] flex-col items-start justify-center py-24">
    <p class="eyebrow">404</p>
    <h1 class="section-title">This page doesn’t exist</h1>
    <p class="mt-4 text-muted">The link may be broken, or the page may have moved.</p>
    <a href="/" class="btn btn-primary mt-8"><Icon name="arrow-left" size={15} /> Back to home</a>
  </section>
</BaseLayout>
